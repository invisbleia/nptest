# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DATABASE_URL: Optional environment variable for Coolify PostgreSQL connection.
# You can also enter and test it directly in the UI!
# Format: postgres://<user>:<password>@<vps_ip_or_domain>:<port>/<dbname>?sslmode=disable
DATABASE_URL="postgres://postgres:mysecretpassword@your-coolify-vps.com:5432/postgres?sslmode=disable"
